  "components": {
    "schemas": {
      "CorridorList": {
        "properties": {
          "data_mode": {
            "type": "string",
            "const": "replay",
            "title": "Data Mode",
            "default": "replay"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "corridors": {
            "items": {
              "$ref": "#/components/schemas/CorridorSummary"
            },
            "type": "array",
            "title": "Corridors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provenance",
          "limitations",
          "corridors"
        ],
        "title": "CorridorList"
      },
      "CorridorState": {
        "properties": {
          "data_mode": {
            "type": "string",
            "const": "replay",
            "title": "Data Mode",
            "default": "replay"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "corridor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Corridor Id"
          },
          "corridor_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Corridor Version Id"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentState"
            },
            "type": "array",
            "title": "Segments"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provenance",
          "limitations",
          "corridor_id",
          "corridor_version_id",
          "as_of",
          "segments",
          "next_cursor"
        ],
        "title": "CorridorState"
      },
      "CorridorSummary": {
        "properties": {
          "corridor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Corridor Id"
          },
          "corridor_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Corridor Version Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "graph_version": {
            "type": "string",
            "title": "Graph Version"
          },
          "data_mode": {
            "type": "string",
            "const": "replay",
            "title": "Data Mode",
            "default": "replay"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "corridor_id",
          "corridor_version_id",
          "name",
          "graph_version"
        ],
        "title": "CorridorSummary"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "conflict",
              "idempotency_conflict",
              "payload_too_large",
              "unsupported_media_type",
              "unprocessable_entity",
              "rate_limited",
              "upstream_unavailable",
              "degraded",
              "internal_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ExternalReference": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "id"
        ],
        "title": "ExternalReference"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineString": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "minItems": 2,
            "title": "Coordinates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "LineString"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "live",
            "title": "Status",
            "default": "live"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Liveness"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Provenance": {
        "properties": {
