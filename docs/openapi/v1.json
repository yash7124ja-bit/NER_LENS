    "/v1/corridors/{corridor_id}/state": {
      "get": {
        "summary": "State",
        "operationId": "state_v1_corridors__corridor_id__state_get",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "corridor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Corridor Id"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
