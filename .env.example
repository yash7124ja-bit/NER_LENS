# Replay default: local SQLite; this does not claim PostgreSQL/PostGIS readiness.
DATABASE_URL=sqlite:///ner_lens_replay.sqlite
NER_LENS_ENV=replay
API_REQUEST_TIMEOUT_SECONDS=10
# Production-only shape (requires separately verified psycopg/PostGIS deployment):
# DATABASE_URL=postgresql+psycopg://ner_lens:change-me@localhost:5432/ner_lens

# Optional providers remain disabled unless explicitly configured and approved.
COPERNICUS_API_URL=
COPERNICUS_API_KEY=
NASA_EARTHDATA_TOKEN=
MAPPLS_API_KEY=
GRAPHHOPPER_API_KEY=
