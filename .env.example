# Names only. Populate locally; never commit credentials. See docs/PROVIDERS.md.
DATABASE_URL=
NER_LENS_ENV=
API_REQUEST_TIMEOUT_SECONDS=
COPERNICUS_API_URL=
COPERNICUS_API_KEY=
NASA_EARTHDATA_TOKEN=
MAPPLS_API_KEY=
GRAPHHOPPER_API_KEY=
# Private GraphHopper service backed by a verified dated extract; both values required together.
GRAPHHOPPER_LOCAL_URL=
GRAPHHOPPER_DATA_DATE=
SACHET_RSS_URL=
IMD_API_STATUS=
IMD_API_URL=
SOURCE_ROUTE_POINTS=
SOURCE_REFRESH_SECONDS=
# Operational-owner-approved maximum age of a field observation at status effective time.
# Empty disables evidence-backed non-unknown status publication; authority orders remain available.
FIELD_REPORT_MAX_AGE_SECONDS=

# Public map style URL (no credentials or query-string secrets).
MAP_STYLE_URL=
# One-time promotion of an existing account. Remove after bootstrap.
NER_LENS_SUPERADMIN_EMAIL=

# Weaviate API credentials stay on the backend. gRPC is not required for REST indexing.
WEAVIATE_REST_ENDPOINT=
WEAVIATE_API=
WEAVIATE_STORY_COLLECTION=

# Private S3-compatible quarantine. Keep the bucket private and configure its default encryption.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
# Trusted private-network ClamAV daemon. Never expose port 3310 publicly.
CLAMD_HOST=
CLAMD_PORT=
