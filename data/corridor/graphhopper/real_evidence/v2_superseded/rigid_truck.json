// Project-specific custom model for the "rigid_truck" profile.
// Numeric limits are copied verbatim from
// data/corridor/graphhopper/vehicle_profiles.yaml (max_weight_t: 16.0,
// max_height_m: 3.8, hgv_exempt: false). Adapted from GraphHopper's own
// official truck.json example (core/src/main/resources/com/graphhopper/
// custom_models/truck.json at tag 11.0), replacing its hard-coded 18t/4m/3m
// thresholds with this project's rigid_truck numbers. hgv_exempt: false
// means an OSM hgv=NO tag DOES exclude this profile, unlike light_goods/
// emergency.
//
// to use this custom model: graph.encoded_values: road_access, car_access,
// hgv, max_width, max_height, car_average_speed, max_weight, max_weight_except

{
  "distance_influence": 1,
  "priority": [
    { "if": "hgv == NO", "multiply_by": "0" },
    { "if": "!car_access && road_access != PRIVATE && hgv != DELIVERY && hgv != DESTINATION", "multiply_by": "0" },
    { "if": "road_access == PRIVATE || hgv == DELIVERY || hgv == DESTINATION", "multiply_by": "0.1" },
    { "if": "max_width < 3 || max_height < 3.8", "multiply_by": "0" },
    { "if": "max_weight < 16 && max_weight_except == MISSING", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed * 0.9" },
    { "if": "true", "limit_to": "95" }
  ]
}
