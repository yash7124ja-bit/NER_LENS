// Project-specific custom model for the "light_goods" profile.
// Numeric limits are copied verbatim from
// data/corridor/graphhopper/vehicle_profiles.yaml (max_weight_t: 3.5,
// max_height_m: 2.5, hgv_exempt: true). Base access rule uses car_access
// (light_goods is not classified as an "hgv" for OSM hgv=* tag purposes,
// which is why it is not gated on the hgv encoded value at all, unlike
// rigid_truck). No legal exemption beyond car_access/road_access is
// invented: private/no-access roads and physical clearance/weight limits
// still apply exactly as they would for any other vehicle.
//
// M0 SECOND correction (consistency extension of the rigid_truck fix):
// max_weight_except no longer bypasses an active max_weight restriction
// below this profile's own limit. Same rationale as rigid_truck.json: no
// authorization-backed applicability input exists in M0 to decide whether
// this vehicle/mission qualifies for a given except-tag grant.
//
// to use this custom model: graph.encoded_values: car_access, road_access,
// max_height, max_weight, max_weight_except, car_average_speed

{
  "distance_influence": 90,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_access == PRIVATE || road_access == NO", "multiply_by": "0" },
    { "if": "max_height < 2.5", "multiply_by": "0" },
    { "if": "max_weight < 3.5", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" }
  ]
}
